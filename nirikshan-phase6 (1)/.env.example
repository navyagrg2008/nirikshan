# Copy to .env. Nothing here is a real secret. Production values come from a secrets manager.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://nirikshan:nirikshan@localhost:5432/nirikshan
REDIS_URL=redis://localhost:6379
# JSON map keyId -> base64 32-byte key. Required in production. Generate: node -e "console.log(JSON.stringify({'k1':require('crypto').randomBytes(32).toString('base64')}))"
ROOT_KEYS=
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=0
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.uploads
SCAN_PROVIDER=builtin
SMTP_HOST=localhost
SMTP_PORT=1025
CAPTCHA_PROVIDER=none
ENABLE_SWAGGER=true
# web
API_INTERNAL_URL=http://localhost:4000
# Phase 6
# Requests per minute per address for routes with no limit of their own. Raise only on a load-test stack.
RATE_LIMIT_DEFAULT_PER_MIN=600
# Seconds to keep each person's officer/admin dashboard numbers. 0 = always fresh. 30 suggested in production.
DASHBOARD_CACHE_SECONDS=0
